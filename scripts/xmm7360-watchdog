#!/usr/bin/env bash
set -euo pipefail

CONN_NAME="${XMM7360_CONN_NAME:-lebara}"
LOG_TAG="xmm7360-watchdog"

log() {
  logger -t "$LOG_TAG" "$*"
}

sleep_jobs_active() {
  systemctl list-jobs --no-legend 2>/dev/null | grep -Eiq 'suspend|hibernate|sleep'
}

ppp_session_healthy() {
  ip link show ppp0 >/dev/null 2>&1 || return 1
  ip -4 addr show dev ppp0 2>/dev/null | grep -q 'inet ' || return 1
  return 0
}

ppp_route_present() {
  ip route show dev ppp0 2>/dev/null | grep -q '^default\|^10\.' || return 0
  ip route show default 2>/dev/null | grep -q ' dev ppp0\>' || return 0
  return 1
}

active_gsm_session_present() {
  nmcli -t -f TYPE,DEVICE connection show --active 2>/dev/null | grep -Eq '^gsm:|:ppp0$'
}

if sleep_jobs_active; then
  log "Sleep/resume job active; skipping watchdog"
  exit 0
fi

if ! mmcli -L | grep -q '/Modem/'; then
  log "No modem detected; scanning"
  mmcli --scan-modems || true
  sleep 2
fi

if sleep_jobs_active; then
  log "Sleep/resume job active after scan; skipping watchdog"
  exit 0
fi

# If the PPP session is already alive, the watchdog must not keep prodding NM/MM.
# The new kernel still brings the modem up; the noisy failures were coming from
# this script repeatedly trying to "recover" a healthy connection.
if ppp_session_healthy && ppp_route_present; then
  exit 0
fi

if ! mmcli -L | grep -q '/Modem/'; then
  log "Still no modem after scan; restarting ModemManager"
  systemctl restart ModemManager || true
  sleep 4
  mmcli --scan-modems || true
  sleep 2
fi

if mmcli -L | grep -q '/Modem/'; then
  if active_gsm_session_present; then
    exit 0
  fi

  if ! nmcli -t -f NAME connection show | grep -Fxq "$CONN_NAME"; then
    log "Configured GSM profile does not exist: ${CONN_NAME}"
    exit 0
  fi

  if ! nmcli -t -f NAME,TYPE,DEVICE connection show --active | grep -Fq "${CONN_NAME}:gsm:"; then
    log "GSM profile inactive; bringing up ${CONN_NAME}"
    nmcli connection up "$CONN_NAME" || true
  fi
fi
